---
interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'NeuStudio',
  description = 'Vanilla Astro project with Tailwind CSS.',
  image = '/og-image.png',
} = Astro.props;

const siteUrl = Astro.site ?? new URL('http://localhost:4321');
const ogImage = new URL(image, siteUrl).toString();
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Syne:wght@400;500;700&display=swap"
    rel="stylesheet"
  />
</head>
