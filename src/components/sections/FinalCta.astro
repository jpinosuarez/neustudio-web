---
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import Button from '../ui/Button.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="bg-neu-brand py-24 text-center text-white">
  <div class="mx-auto flex max-w-3xl flex-col items-center px-4">
    <h2 class="font-display text-4xl font-bold tracking-tight md:text-6xl">
      {t('ctaBlock.title')}
    </h2>
    <p class="mt-6 max-w-2xl text-base text-white/90 md:text-lg">
      {t('ctaBlock.subtitle')}
    </p>
    <Button variant="accent" size="lg" class="mt-8 text-white">
      {t('ctaBlock.button')}
    </Button>
  </div>
</section>
