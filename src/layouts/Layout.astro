---
import Head from '../components/layout/Head.astro';
import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import '../styles/global.css';

interface Props {
  lang: 'es' | 'en' | 'de';
  title?: string;
  description?: string;
  image?: string;
}

const { lang, title, description, image } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <Head lang={lang} title={title} description={description} image={image} />
  <body class="bg-neu-light font-sans text-neu-dark">
    <Header />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>
