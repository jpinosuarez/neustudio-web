---
import Head from '../components/layout/Head.astro';
import '../styles/global.css';

interface Props {
  lang: 'es' | 'en' | 'de';
  title?: string;
  description?: string;
  image?: string;
}

const { lang, title, description, image } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <Head lang={lang} title={title} description={description} image={image} />
  <body class="bg-neu-light font-sans text-neu-dark">
    <header class="border-b border-neu-muted/20">
      <div class="mx-auto max-w-6xl px-6 py-4">
        <p class="font-display text-lg">NeuStudio</p>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-neu-muted/20">
      <div class="mx-auto max-w-6xl px-6 py-4 text-sm text-neu-muted">
        © {new Date().getFullYear()} NeuStudio.
      </div>
    </footer>
  </body>
</html>
