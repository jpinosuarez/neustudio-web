---
import Head from '../components/layout/Head.astro';
import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import CookieBanner from '@components/ui/CookieBanner.astro';
import '../styles/global.css';

interface Props {
  lang: 'es' | 'en' | 'de';
  title?: string;
  description?: string;
  ogImage?: string;
}

const { lang, title, description, ogImage } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <Head lang={lang} title={title} description={description} ogImage={ogImage} />
  <body class="bg-grid-orb bg-neu-dark font-sans text-neu-light pt-[env(safe-area-inset-top)] pb-[env(safe-area-inset-bottom)]">

    <Header />

    <main>
      <slot />
    </main>

    <Footer />

    <CookieBanner />
  </body>
</html>
