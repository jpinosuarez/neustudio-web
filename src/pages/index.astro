---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="NeuStudio"
  description="Clean, vanilla Astro starter with Tailwind CSS and strict TypeScript."
>
  <section class="mx-auto max-w-6xl px-6 py-20">
    <h1 class="text-4xl">Vanilla Astro + Tailwind</h1>
    <p class="mt-4 max-w-2xl text-neu-muted">
      Minimal foundation project with strict semantic tokens and a reusable layout system.
    </p>
  </section>
</Layout>
