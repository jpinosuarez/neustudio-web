---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../i18n/utils';
import Button from '../../components/ui/Button.astro';
import type { Language } from '../../i18n/ui';
import { defaultLanguage } from '../../i18n/ui';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
  ];
}

const { lang } = Astro.params as { lang: Language };
const t = useTranslations(lang);

const contactPath = lang === defaultLanguage ? '/contacto' : `/${lang}/contacto`;

const portfolioEntries = await getCollection('portfolio', ({ data }) => data.lang === lang);

const sorted = portfolioEntries.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return (b.data.publishedDate?.getTime() ?? 0) - (a.data.publishedDate?.getTime() ?? 0);
});

// entry.id includes "lang/" prefix (e.g. "en/berlin-kitchen-supply"), strip it for the URL slug
function detailPath(entryId: string): string {
  const slug = entryId.replace(/^[a-z]{2}\//, '');
  return lang === defaultLanguage ? `/portfolio/${slug}` : `/${lang}/portfolio/${slug}`;
}
---

<Layout lang={lang} title={t('pageTitles.portfolio')} description="Our success stories and case studies">
  <header class="bg-neu-light py-24 text-center">
    <div class="mx-auto max-w-3xl px-4">
      <h1 class="font-display text-4xl font-bold tracking-tight text-neu-dark md:text-5xl">
        {t('pageTitles.portfolio')}
      </h1>
      <p class="mt-4 text-lg text-neu-muted">
        Discover how we've helped local businesses in Berlin scale their digital presence.
      </p>
    </div>
  </header>

  <section class="mx-auto max-w-7xl px-4 py-16">
    {sorted.length > 0 ? (
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        {sorted.map((entry) => (
          <a
            href={detailPath(entry.id)}
            class="group flex flex-col overflow-hidden rounded-3xl border border-neu-dark/5 bg-white transition-all duration-200 hover:-translate-y-1 hover:shadow-md"
          >
            <div class="aspect-[3/2] w-full overflow-hidden bg-neu-light">
              {entry.data.image && (
                <img
                  src={entry.data.image.src}
                  alt={entry.data.imageAlt}
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                />
              )}
            </div>
            <div class="flex flex-1 flex-col justify-between p-6">
              <div>
                <span class="mb-2 inline-block rounded-xl bg-neu-brand/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-neu-brand">
                  {entry.data.category}
                </span>
                <h2 class="mt-2 font-display text-xl font-bold tracking-tight text-neu-dark">
                  {entry.data.title}
                </h2>
                <p class="mt-2 text-sm text-neu-muted">
                  {entry.data.shortDescription}
                </p>
                {entry.data.metrics && entry.data.metrics.length > 0 && (
                  <div class="mt-4 flex flex-wrap gap-3">
                    {entry.data.metrics.map((metric) => (
                      <span class="inline-flex items-center gap-1 rounded-xl bg-neu-accent/10 px-2.5 py-1 text-xs font-semibold text-neu-accent">
                        {metric.value}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="rounded-3xl border border-neu-dark/5 bg-white py-16 text-center">
        <p class="text-lg text-neu-muted">No portfolio entries available in this language yet.</p>
      </div>
    )}
  </section>

  <section class="pb-16 text-center">
    <Button href={contactPath} variant="accent" size="lg">
      {t('cta.proposal')}
    </Button>
  </section>
</Layout>