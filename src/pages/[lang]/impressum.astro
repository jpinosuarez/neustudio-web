---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';
import type { Language } from '../../i18n/ui';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
  ];
}

const { lang } = Astro.params as { lang: Language };
const t = useTranslations(lang);
---

<Layout lang={lang} title={t('pageTitles.impressum')} description="Legal information about NeuStudio">
  <main class="mx-auto max-w-3xl px-4 py-24">
    <h1 class="font-display text-4xl font-bold tracking-tight text-neu-dark md:text-5xl">
      {t('pageTitles.impressum')}
    </h1>
    <p class="mt-6 text-neu-muted">
      Content coming soon...
    </p>
  </main>
</Layout>
