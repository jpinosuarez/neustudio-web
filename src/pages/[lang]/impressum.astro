---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';
import type { Language } from '../../i18n/ui';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
  ];
}

const { lang } = Astro.params as { lang: Language };
const t = useTranslations(lang);
---

<Layout lang={lang} title={t('pageTitles.impressum')} description="Legal information about NeuStudio">
  <main class="mx-auto max-w-3xl px-4 py-24 prose prose-slate md:prose-lg prose-headings:font-display prose-headings:tracking-tight prose-a:text-neu-brand">
    <h1>{t('pageTitles.impressum')}</h1>

    <!-- Contenido del Impressum generado por eRecht24 -->
    <p>Dante Joaquin Pino Suarez<br />
    Dante Joaquin Pino Suarez<br />
    Ufnaustra&szlig;e 16<br />
    10553 Berlin</p>

    <h2>Kontakt</h2>
    <p>Telefon: 016096579389<br/>
    E-Mail: pinosuarezjoaquin@gmail.com</p>

    <h2>Umsatzsteuer-ID</h2>
    <p>Umsatzsteuer-Identifikationsnummer gem&auml;&szlig; &sect; 27 a Umsatzsteuergesetz:<br />
    DE460405449</p>

    <h2>Wirtschafts&shy;identifikations&shy;nummer</h2>
    <p>DE460405449</p>

    <h2>Verbraucher&shy;streit&shy;beilegung / Universal&shy;schlichtungs&shy;stelle</h2>
