---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';
import { defaultLanguage, type Language } from '../../i18n/ui';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
  ];
}

const { lang } = Astro.params as { lang: Language };
const t = useTranslations(lang);

const localizedRoot = lang === defaultLanguage ? '/' : `/${lang}/`;
---

<Layout lang={lang} title={t('contactForm.pageTitle')} description={t('contactForm.pageDescription')}>
  <main class="mx-auto max-w-2xl px-4 py-16 md:py-24">
    <!-- Success State (shown when redirected after Netlify form submission) -->
    <div id="success-state" class="hidden text-center">
      <div class="rounded-3xl border border-neu-dark/5 bg-white p-10 shadow-sm">
        <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-neu-brand/10 text-3xl" aria-hidden="true">
          ✅
        </div>
        <h1 class="font-display text-3xl font-bold tracking-tight text-neu-dark">
          {t('contactForm.successTitle')}
        </h1>
        <p class="mt-4 text-lg text-neu-muted">
          {t('contactForm.successMessage')}
        </p>
        <a
          href={localizedRoot}
          class="mt-8 inline-flex min-h-12 items-center justify-center rounded-xl bg-neu-accent px-8 py-3 text-base font-semibold text-white shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md"
        >
          {t('contactForm.successCta')}
        </a>
      </div>
    </div>

    <!-- Form State (hidden when success state is shown) -->
    <div id="form-state">
      <div class="mb-8 text-center">
        <h1 class="font-display text-3xl font-bold tracking-tight text-neu-dark md:text-4xl">
          {t('contactForm.pageTitle')}
        </h1>
        <p class="mt-3 text-lg text-neu-muted">
          {t('contactForm.pageDescription')}
        </p>
      </div>

      <!-- Progress Indicator -->
      <div class="mb-8 flex items-center justify-center gap-2" role="progressbar" aria-valuenow={1} aria-valuemin={1} aria-valuemax={3} aria-label={`${t('contactForm.stepLabel')} 1 ${t('contactForm.stepOf')} 3`}>
        <span class="inline-block h-3 w-3 rounded-full bg-neu-brand transition-colors duration-300" id="progress-dot-1" aria-hidden="true"></span>
        <span class="inline-block h-3 w-3 rounded-full bg-neu-dark/10 transition-colors duration-300" id="progress-dot-2" aria-hidden="true"></span>
        <span class="inline-block h-3 w-3 rounded-full bg-neu-dark/10 transition-colors duration-300" id="progress-dot-3" aria-hidden="true"></span>
        <span class="ml-2 text-xs text-neu-muted" id="progress-label" aria-live="polite">{t('contactForm.stepLabel')} 1 {t('contactForm.stepOf')} 3</span>
      </div>

      <form
        id="contact-form"
        name="contact"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/contacto"
        class="rounded-3xl border border-neu-dark/5 bg-white p-6 shadow-sm md:p-10"
      >
        <!-- Netlify hidden fields -->
        <input type="hidden" name="form-name" value="contact" />
        <input type="hidden" name="language" value={lang} />

        <!-- Honeypot (hidden from humans, visible to bots) -->
        <p class="hidden" aria-hidden="true">
          <label>
            Don't fill this out:
            <input name="bot-field" tabindex="-1" autocomplete="off" />
          </label>
        </p>

        <!-- Hidden step data fields -->
        <input type="hidden" name="pain_point" id="field-pain-point" value="" />
        <input type="hidden" name="budget" id="field-budget" value="" />
        <input type="hidden" name="timeline" id="field-timeline" value="" />

        <!-- ===== STEP 1: QUALIFICATION ===== -->
        <fieldset data-step="1" aria-hidden="false" class="space-y-4">
          <legend class="mb-6 font-display text-2xl font-bold tracking-tight text-neu-dark md:text-3xl">
            {t('contactForm.step1Title')}
          </legend>

          <button type="button"
            class="w-full min-h-[56px] rounded-xl border-2 border-neu-dark/10 bg-neu-light px-4 py-4 text-left text-base font-medium text-neu-dark transition-all hover:border-neu-brand hover:bg-neu-brand/5 aria-pressed:border-neu-brand aria-pressed:bg-neu-brand/10 aria-pressed:text-neu-brand"
            data-pain-point="slow"
            aria-pressed="false"
          >
            <span class="mr-3" aria-hidden="true">🐢</span>
            {t('contactForm.step1OptionSlow')}
          </button>

          <button type="button"
            class="w-full min-h-[56px] rounded-xl border-2 border-neu-dark/10 bg-neu-light px-4 py-4 text-left text-base font-medium text-neu-dark transition-all hover:border-neu-brand hover:bg-neu-brand/5 aria-pressed:border-neu-brand aria-pressed:bg-neu-brand/10 aria-pressed:text-neu-brand"
            data-pain-point="seo"
            aria-pressed="false"
          >
            <span class="mr-3" aria-hidden="true">🔍</span>
            {t('contactForm.step1OptionSeo')}
          </button>

          <button type="button"
            class="w-full min-h-[56px] rounded-xl border-2 border-neu-dark/10 bg-neu-light px-4 py-4 text-left text-base font-medium text-neu-dark transition-all hover:border-neu-brand hover:bg-neu-brand/5 aria-pressed:border-neu-brand aria-pressed:bg-neu-brand/10 aria-pressed:text-neu-brand"
            data-pain-point="startup"
            aria-pressed="false"
          >
            <span class="mr-3" aria-hidden="true">🚀</span>
            {t('contactForm.step1OptionDesign')}
          </button>

          <button type="button"
            class="w-full min-h-[56px] rounded-xl border-2 border-neu-dark/10 bg-neu-light px-4 py-4 text-left text-base font-medium text-neu-dark transition-all hover:border-neu-brand hover:bg-neu-brand/5 aria-pressed:border-neu-brand aria-pressed:bg-neu-brand/10 aria-pressed:text-neu-brand"
            data-pain-point="other"
            aria-pressed="false"
          >
            <span class="mr-3" aria-hidden="true">💬</span>
            {t('contactForm.step1OptionOther')}
          </button>

          <!-- Hidden textarea for Option 4 — becomes visible when "Other" is selected -->
          <div id="custom-pain-point-container" class="overflow-hidden transition-all duration-300 ease-in-out max-h-0 opacity-0">
            <textarea
              id="custom-pain-point"
              name="custom_pain_point"
              rows="3"
              placeholder="Tell us more about what you need..."
              class="mt-2 w-full rounded-xl border border-neu-dark/10 bg-neu-light px-4 py-3 text-neu-dark placeholder:text-neu-muted/60 focus:border-neu-brand focus:outline-none focus:ring-2 focus:ring-neu-brand/20 resize-none transition-all"
            ></textarea>
          </div>

          <div class="pt-4 text-right">
            <button type="button" id="step1-next"
              class="inline-flex min-h-12 items-center justify-center rounded-xl bg-neu-brand px-8 py-3 text-base font-semibold text-white shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md disabled:pointer-events-none disabled:opacity-50"
              disabled
            >
              {t('contactForm.step1Next')}
              <span class="ml-2" aria-hidden="true">→</span>
            </button>
          </div>
        </fieldset>

        <!-- ===== STEP 2: PROJECT DETAILS ===== -->
        <fieldset data-step="2" aria-hidden="true" class="hidden space-y-6">
          <legend class="mb-6 font-display text-2xl font-bold tracking-tight text-neu-dark md:text-3xl">
            {t('contactForm.step2Title')}
          </legend>

          <!-- Budget -->
          <div>
            <span class="mb-3 block text-sm font-semibold text-neu-dark">{t('contactForm.step2BudgetLabel')}</span>
            <div class="flex flex-col gap-3">
              <label class="flex min-h-[48px] cursor-pointer items-center gap-3 rounded-xl border-2 border-neu-dark/10 bg-neu-light px-4 py-3 text-base font-medium text-neu-dark transition-all has-[:checked]:border-neu-brand has-[:checked]:bg-neu-brand/10 has-[:checked]:text-neu-brand">
                <input type="radio" name="budget-radio" value="low" class="h-4 w-4 accent-neu-brand" />
                {t('contactForm.step2BudgetLow')}
              </label>
              <label class="flex min-h-[48px] cursor-pointer items-center gap-3 rounded-xl border-2 border-neu-dark/10 bg-neu-light px-4 py-3 text-base font-medium text-neu-dark transition-all has-[:checked]:border-neu-brand has-[:checked]:bg-neu-brand/10 has-[:checked]:text-neu-brand">
                <input type="radio" name="budget-radio" value="mid" class="h-4 w-4 accent-neu-brand" />
                {t('contactForm.step2BudgetMid')}
              </label>
              <label class="flex min-h-[48px] cursor-pointer items-center gap-3 rounded-xl border-2 border-neu-dark/10 bg-neu-light px-4 py-3 text-base font-medium text-neu-dark transition-all has-[:checked]:border-neu-brand has-[:checked]:bg-neu-brand/10 has-[:checked]:text-neu-brand">
                <input type="radio" name="budget-radio" value="high" class="h-4 w-4 accent-neu-brand" />
                {t('contactForm.step2BudgetHigh')}
              </label>
            </div>
          </div>

          <!-- Timeline -->
          <div>
            <span class="mb-3 block text-sm font-semibold text-neu-dark">{t('contactForm.step2TimelineLabel')}</span>
            <div class="flex flex-col gap-3">
              <label class="flex min-h-[48px] cursor-pointer items-center gap-3 rounded-xl border-2 border-neu-dark/10 bg-neu-light px-4 py-3 text-base font-medium text-neu-dark transition-all has-[:checked]:border-neu-brand has-[:checked]:bg-neu-brand/10 has-[:checked]:text-neu-brand">
                <input type="radio" name="timeline-radio" value="asap" class="h-4 w-4 accent-neu-brand" />
                {t('contactForm.step2TimelineAsap')}
              </label>
              <label class="flex min-h-[48px] cursor-pointer items-center gap-3 rounded-xl border-2 border-neu-dark/10 bg-neu-light px-4 py-3 text-base font-medium text-neu-dark transition-all has-[:checked]:border-neu-brand has-[:checked]:bg-neu-brand/10 has-[:checked]:text-neu-brand">
                <input type="radio" name="timeline-radio" value="month" class="h-4 w-4 accent-neu-brand" />
                {t('contactForm.step2TimelineMonth')}
              </label>
              <label class="flex min-h-[48px] cursor-pointer items-center gap-3 rounded-xl border-2 border-neu-dark/10 bg-neu-light px-4 py-3 text-base font-medium text-neu-dark transition-all has-[:checked]:border-neu-brand has-[:checked]:bg-neu-brand/10 has-[:checked]:text-neu-brand">
                <input type="radio" name="timeline-radio" value="quarter" class="h-4 w-4 accent-neu-brand" />
                {t('contactForm.step2TimelineQuarter')}
              </label>
            </div>
          </div>

          <div class="flex items-center justify-between pt-4">
            <button type="button"
              class="step-back inline-flex min-h-12 items-center gap-1 rounded-xl px-4 py-3 text-sm font-medium text-neu-muted transition-colors hover:text-neu-dark"
            >
              <span aria-hidden="true">←</span>
              {t('contactForm.step2Back')}
            </button>
            <button type="button" id="step2-next"
              class="inline-flex min-h-12 items-center justify-center rounded-xl bg-neu-brand px-8 py-3 text-base font-semibold text-white shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md disabled:pointer-events-none disabled:opacity-50"
              disabled
            >
              {t('contactForm.step2Next')}
              <span class="ml-2" aria-hidden="true">→</span>
            </button>
          </div>
        </fieldset>

        <!-- ===== STEP 3: IDENTITY ===== -->
        <fieldset data-step="3" aria-hidden="true" class="hidden space-y-5">
          <legend class="mb-6 font-display text-2xl font-bold tracking-tight text-neu-dark md:text-3xl">
            {t('contactForm.step3Title')}
          </legend>

          <div>
            <label for="full_name" class="mb-2 block text-sm font-semibold text-neu-dark">{t('contactForm.step3NameLabel')}</label>
            <input type="text" id="full_name" name="full_name" required
              autocomplete="name"
              placeholder={t('contactForm.step3NamePlaceholder')}
              class="w-full rounded-xl border border-neu-dark/10 bg-neu-light px-4 py-3 text-neu-dark placeholder:text-neu-muted/60 focus:border-neu-brand focus:outline-none focus:ring-2 focus:ring-neu-brand/20"
            />
          </div>

          <div>
            <label for="business_name" class="mb-2 block text-sm font-semibold text-neu-dark">{t('contactForm.step3BusinessLabel')}</label>
            <input type="text" id="business_name" name="business_name"
              autocomplete="organization"
              placeholder={t('contactForm.step3BusinessPlaceholder')}
              class="w-full rounded-xl border border-neu-dark/10 bg-neu-light px-4 py-3 text-neu-dark placeholder:text-neu-muted/60 focus:border-neu-brand focus:outline-none focus:ring-2 focus:ring-neu-brand/20"
            />
          </div>

          <div>
            <label for="email" class="mb-2 block text-sm font-semibold text-neu-dark">{t('contactForm.step3EmailLabel')}</label>
            <input type="email" id="email" name="email" required
              autocomplete="email"
              placeholder={t('contactForm.step3EmailPlaceholder')}
              class="w-full rounded-xl border border-neu-dark/10 bg-neu-light px-4 py-3 text-neu-dark placeholder:text-neu-muted/60 focus:border-neu-brand focus:outline-none focus:ring-2 focus:ring-neu-brand/20"
            />
          </div>

          <div>
            <label for="phone" class="mb-2 block text-sm font-semibold text-neu-dark">{t('contactForm.step3PhoneLabel')}</label>
            <input type="tel" id="phone" name="phone"
              autocomplete="tel"
              placeholder={t('contactForm.step3PhonePlaceholder')}
              class="w-full rounded-xl border border-neu-dark/10 bg-neu-light px-4 py-3 text-neu-dark placeholder:text-neu-muted/60 focus:border-neu-brand focus:outline-none focus:ring-2 focus:ring-neu-brand/20"
            />
          </div>

          <div class="flex items-center justify-between pt-4">
            <button type="button"
              class="step-back inline-flex min-h-12 items-center gap-1 rounded-xl px-4 py-3 text-sm font-medium text-neu-muted transition-colors hover:text-neu-dark"
            >
              <span aria-hidden="true">←</span>
              {t('contactForm.step3Back')}
            </button>
            <button type="submit"
              class="inline-flex min-h-12 items-center justify-center rounded-xl bg-neu-accent px-8 py-3 text-base font-semibold text-white shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md"
            >
              {t('contactForm.step3Submit')}
            </button>
          </div>

          <p class="pt-2 text-center text-xs text-neu-muted">
            {t('footer.tagline')} — {t('hero.trustSignal')}
          </p>
        </fieldset>
      </form>
    </div>
  </main>
</Layout>

<script>
  (function () {
    // ─── Query param detection for success state ───
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('success') === 'true') {
      document.getElementById('success-state')?.classList.remove('hidden');
      document.getElementById('form-state')?.classList.add('hidden');
      return; // halt all form logic
    }

    const form = document.getElementById('contact-form');
    if (!(form instanceof HTMLFormElement)) return;

    // ─── Element references ───
    const steps = form.querySelectorAll('[data-step]');
    const dots = [
      document.getElementById('progress-dot-1'),
      document.getElementById('progress-dot-2'),
      document.getElementById('progress-dot-3'),
    ];
    const progressLabel = document.getElementById('progress-label');
    const fieldPainPoint = document.getElementById('field-pain-point') as HTMLInputElement | null;
    const fieldBudget = document.getElementById('field-budget') as HTMLInputElement | null;
    const fieldTimeline = document.getElementById('field-timeline') as HTMLInputElement | null;

    let currentStep = 0; // 0-based index

    function renderProgress(index: number) {
      dots.forEach((dot, i) => {
        if (dot) {
          dot.className = `inline-block h-3 w-3 rounded-full transition-colors duration-300 ${
            i <= index ? 'bg-neu-brand' : 'bg-neu-dark/10'
          }`;
        }
      });
      if (progressLabel) {
        // Extract step text from the progress label by updating numbers
        const label = progressLabel.textContent || '';
        progressLabel.textContent = label.replace(/\d+/, String(index + 1));
      }
      // Update aria-valuenow on the progressbar
      const progressbar = document.querySelector('[role="progressbar"]');
      if (progressbar) {
        progressbar.setAttribute('aria-valuenow', String(index + 1));
        progressbar.setAttribute('aria-label', `Step ${index + 1} of 3`);
      }
    }

    function showStep(index: number) {
      steps.forEach((step, i) => {
        if (i === index) {
          step.classList.remove('hidden');
          step.setAttribute('aria-hidden', 'false');
        } else {
          step.classList.add('hidden');
          step.setAttribute('aria-hidden', 'true');
        }
      });
      currentStep = index;
      renderProgress(index);

      // Focus the first focusable element in the new step
      const currentFieldset = steps[index];
      if (currentFieldset) {
        const firstFocusable = currentFieldset.querySelector(
          'button, input:not([type="hidden"]), select, textarea, [tabindex]:not([tabindex="-1"])'
        );
        if (firstFocusable instanceof HTMLElement) {
          firstFocusable.focus({ preventScroll: false });
          firstFocusable.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }
    }

    // ─── Step 1: Pain point toggle buttons ───
    const painButtons = form.querySelectorAll('[data-pain-point]');
    let selectedPain = '';
    const customPainContainer = document.getElementById('custom-pain-point-container');
    const customPainTextarea = document.getElementById('custom-pain-point') as HTMLTextAreaElement | null;

    painButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        // Deselect all
        painButtons.forEach((b) => b.setAttribute('aria-pressed', 'false'));

        // Select clicked
        btn.setAttribute('aria-pressed', 'true');
        selectedPain = btn.getAttribute('data-pain-point') || '';
        if (fieldPainPoint) fieldPainPoint.value = selectedPain;

        // Toggle textarea visibility when "Other" is selected
        const isOther = selectedPain === 'other';
        if (customPainContainer) {
          if (isOther) {
            customPainContainer.classList.remove('max-h-0', 'opacity-0');
            customPainContainer.classList.add('max-h-48', 'opacity-100');
            if (customPainTextarea) customPainTextarea.focus();
          } else {
            customPainContainer.classList.remove('max-h-48', 'opacity-100');
            customPainContainer.classList.add('max-h-0', 'opacity-0');
          }
        }

        // Enable next button
        const nextBtn = document.getElementById('step1-next');
        if (nextBtn instanceof HTMLButtonElement) {
          nextBtn.disabled = false;
        }
      });
    });

    // Step 1 → Step 2
    const step1Next = document.getElementById('step1-next');
    if (step1Next instanceof HTMLButtonElement) {
      step1Next.addEventListener('click', () => {
        if (selectedPain) showStep(1);
      });
    }

    // ─── Step 2: Budget + Timeline radio validation ───
    const budgetRadios = form.querySelectorAll('input[name="budget-radio"]');
    const timelineRadios = form.querySelectorAll('input[name="timeline-radio"]');
    const step2Next = document.getElementById('step2-next');

    function checkStep2Ready() {
      if (!(form instanceof HTMLFormElement)) return;
      const budgetSelected = form.querySelector('input[name="budget-radio"]:checked');
      const timelineSelected = form.querySelector('input[name="timeline-radio"]:checked');
      const ready = !!(budgetSelected && timelineSelected);

      if (step2Next instanceof HTMLButtonElement) {
        step2Next.disabled = !ready;
      }

      // Update hidden fields
      if (budgetSelected && fieldBudget) fieldBudget.value = (budgetSelected as HTMLInputElement).value;
      if (timelineSelected && fieldTimeline) fieldTimeline.value = (timelineSelected as HTMLInputElement).value;
    }

    budgetRadios.forEach((radio) => radio.addEventListener('change', checkStep2Ready));
    timelineRadios.forEach((radio) => radio.addEventListener('change', checkStep2Ready));

    if (step2Next instanceof HTMLButtonElement) {
      step2Next.addEventListener('click', () => {
        showStep(2);
      });
    }

    // ─── Back buttons (Steps 2 & 3) ───
    const backButtons = form.querySelectorAll('.step-back');
    backButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (currentStep > 0) showStep(currentStep - 1);
      });
    });

    // ─── Netlify form submission ───
    // Netlify Forms requires real POST submission, so we don't prevent default.
    // The action="/contacto" with ?success=true query param will show the success state.

    // ─── Keyboard: Enter on Step 1 / Step 2 should advance ───
    form.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const active = document.activeElement;
        if (active && active.closest('[data-step="0"]')) {
          e.preventDefault();
          if (selectedPain) showStep(1);
        } else if (active && active.closest('[data-step="1"]')) {
          if (step2Next instanceof HTMLButtonElement && !step2Next.disabled) {
            e.preventDefault();
            showStep(2);
          }
        }
      }
    });

    // ─── Init ───
    showStep(0);
  })();
</script>